# Build and test environment for Ubuntu 22.04 (gcc 11, the oldest supported
# compiler), with CERN's eos-xrootd client library.
FROM ubuntu:22.04
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      g++ cmake make ninja-build git ca-certificates curl libsqlite3-dev \
 && curl -sSfL https://storage-ci.web.cern.ch/storage-ci/storageci.key -o /etc/apt/keyrings/storage-ci.asc \
 && printf 'Types: deb\nURIs: https://storage-ci.web.cern.ch/storage-ci/ubuntu/eos/diopside\nSuites: jammy\nComponents: jammy/tag/5.5 jammy/deps/5.5\nSigned-By: /etc/apt/keyrings/storage-ci.asc\n' \
      > /etc/apt/sources.list.d/eos.sources \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libeosxrootd-client-dev eos-xrootd-plugins \
 && rm -rf /var/lib/apt/lists/*
# For scripts/build-packages.sh.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends build-essential debhelper lintian \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /build
