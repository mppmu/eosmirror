# Environment of the MGM of the test instance (container environment and
# /etc/sysconfig/eos_env for the start scripts). No quotes: podman reads this
# file literally.
DAEMON_COREFILE_LIMIT=unlimited
LD_PRELOAD=/usr/lib64/libjemalloc.so
EOS_INSTANCE_NAME=eosmirror
EOS_GEOTAG=test::local
EOS_MGM_ALIAS=eosmirror-mgm.eosmirror.test
XRD_ROLES=mgm
KRB5RCACHETYPE=none
EOS_AUTOLOAD_CONFIG=default
EOS_MGM_HOST=eosmirror-mgm.eosmirror.test
EOS_MGM_HOST_TARGET=eosmirror-mgm.eosmirror.test
EOS_NS_ACCOUNTING=1
EOS_SYNCTIME_ACCOUNTING=1
EOS_MGM_FUSEX_PORT=1100
EOS_MGM_HTTP_PORT=0
EOS_MGM_GRPC_PORT=0
EOS_MGM_WNC_PORT=0
XDG_CACHE_HOME=/var/cache/eos/
# Several filesystems of the single FST in one scheduling group.
EOS_ALLOW_SAME_HOST_IN_GROUP=1
